{
  "expo": {
    "name": "Vantage",
    "slug": "vantage-replay",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "vantage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.vantage.spectator",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "dev.vantage.spectator",
      "adaptiveIcon": {
        "backgroundColor": "#111A1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "./plugins/with-gl-constructor",
      ["expo-splash-screen", {
        "backgroundColor": "#101719",
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 96,
        "dark": { "backgroundColor": "#101719" }
      }],
      ["expo-asset", { "assets": ["./assets/licenses/third_party_notices.json"] }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
